#!/bin/bash -l
#PBS -N v2vit_cont
#PBS -l select=1:ncpus=8:mem=64GB:ngpus=1:gpu_id=H100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m n

# Resume training of surrogate_v2_vit (preset=base, MSE, val=0.229 at epoch 29)
# for 80 more epochs with lower LR + cosine, no warmup.

cd $PBS_O_WORKDIR

CAMPAIGN="/scratch/maitreje/dsw/complex_terrain_v1"
DATA="/scratch/maitreje/dsw/training_v2"
RESUME="$HOME/dsw/data/models/surrogate_v2_vit/best.pt"
OUT="$HOME/dsw/data/models/surrogate_v2_vit_continue"

mkdir -p "$OUT"
[ -d $DATA ] || { echo MISSING:$DATA; exit 1; }
[ -f $RESUME ] || { echo MISSING:$RESUME; exit 1; }
nvidia-smi >/dev/null || { echo "GPU missing"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

cd $HOME/dsw/services/module2b-surrogate
python -u train_v2_vit.py \
  --data-dir   $DATA \
  --splits-yaml $CAMPAIGN/manifests/dataset_v2_splits.yaml \
  --norm-yaml   $CAMPAIGN/manifests/dataset_v2_norm.yaml \
  --out-dir    $OUT \
  --resume     $RESUME \
  --epochs 80 \
  --batch-size 4 \
  --preset base \
  --loss-type mse \
  --lr 5e-5 \
  --weight-decay 0.1 \
  --warmup-epochs 0 \
  --num-workers 4 \
  --device cuda
