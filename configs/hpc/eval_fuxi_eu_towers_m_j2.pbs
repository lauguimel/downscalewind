#!/bin/bash -l
#PBS -N fuxi_eu_towers_mj2
#PBS -l select=1:ncpus=8:mem=48GB:ngpus=1:gpu_id=A100
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n

# FuXi-CFD EU-towers benchmark (OPE + IPR, JJA 2020) — M_J2 ABLATION: the
# FROZEN M_I5 correction network (calibrated at 10 m only, no calm gate)
# evaluated with the v3 frozen surrogate (32 levels, 0-200 m AGL), instead of
# its native v2 surrogate (24 levels, 0-100 m). Isolates the surrogate's own
# contribution from the M_I8 multi-height calibration:
#   (M_I5, v2) = "before" (configs/hpc/eval_fuxi_eu_towers.pbs, 2026-07-30)
#   (M_I8, v3) = "after"  (configs/hpc/eval_fuxi_eu_towers_m_i8.pbs, job 25358521)
#   (M_I5, v3) = THIS RUN
# surrogate effect = (M_I5,v3) - (M_I5,v2) ; calibration effect = (M_I8,v3) - (M_I5,v3)
#
# Same script/sample/FuXi model as the M_I8 run above. ANN checkpoint swapped
# to M_I5's (no training here — pure evaluation). See
# configs/training/devine_style_M_J2_i5_on_v3.yaml header for why an M_I5
# checkpoint (era5_dim=408, independent of the surrogate's nz) loads cleanly
# against the v3 surrogate.
#
# FuXi predictions are deterministic given the sample (seed=42, same pairings
# parquet, same n-per-station) and do not depend on our model at all: this run
# seeds the resume cache with fuxi_partial.parquet COPIED from
# data/validation/fuxi_eu_towers_m_i8/ (2026-09-14) to skip ~60 min of
# redundant CPU ONNX inference. Verify sample_pairings.parquet keys match
# before trusting the resume — see mission report.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"

CFG="$BASE/configs/training/devine_style_M_J2_i5_on_v3.yaml"
ANN="$BASE/data/models/surrogate_v2_devine_M_I5_encoder/best.pt"
PAIRINGS="$BASE/data/inference/icos_eu_towers.parquet"
ERA5="$BASE/data/raw/era5_hourly_jja2020_eu.zarr"
STORE100="$BASE/data/raw/era5_100m_jja2020eu.zarr"
ONNX="$BASE/data/models/fuxicfd_official/fuxicfd-model/model/fuxicfd_model.onnx"
SCALER="$BASE/data/models/fuxicfd_official/fuxicfd-model/inference_example/normalization"
CACHE="/scratch/maitreje/dsw/fuxi_eu_towers_cache"
OUT="$BASE/data/validation/fuxi_eu_towers_m_i5_on_v3"

NPS="${NPS:-250}"

mkdir -p "$OUT" "$CACHE"
for f in "$CFG" "$ANN" "$PAIRINGS" "$ONNX"; do
  [ -e "$f" ] || { echo "MISSING:$f"; exit 1; }
done
for d in "$ERA5" "$STORE100"; do
  [ -d "$d" ] || { echo "MISSING store:$d"; exit 1; }
done

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
  [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8

cd "$BASE"
nvidia-smi -L

echo "=== FuXi-CFD EU towers (OPE/IPR, JJA 2020) — M_J2 ablation (M_I5 on v3) — NPS=$NPS ==="
python -u services/module2b-surrogate/score_fuxi_eu_towers.py \
  --config "$CFG" --ann-checkpoint "$ANN" \
  --pairings "$PAIRINGS" \
  --era5-store "$ERA5" --store-100m "$STORE100" \
  --onnx "$ONNX" --scaler-dir "$SCALER" \
  --cache-dir "$CACHE" --out-dir "$OUT" \
  --n-per-station "$NPS" \
  --device cuda --fuxi-device cpu \
  --batch-size 16 --fuxi-batch-size 16 \
  --max-delta-h 1.5 --n-prep-workers 8 --seed 42 \
  2>&1 | tee "$OUT/score.log"
RC=${PIPESTATUS[0]}
echo "RC_SCORE=$RC"
exit "$RC"
