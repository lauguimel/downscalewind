#!/bin/bash -l
#PBS -N devine_M_I3_scalar
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m n

# M_I3 PRODUCTION — SCALAR arm (M_H'1f, topo_dim=12 phys features, no encoder).
# Combined steep+plain dataset (609,388 pairings, 529 disjoint stations).
# Prereq: cache fully pre-materialised by devine_style_M_I3_materialise_cache.pbs.
# overwrite_cache=false → ERA5 store never read; pure cache-hit training.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_I3_scalar.yaml"
OUT="$BASE/data/models/surrogate_v2_devine_M_I3_scalar"
CACHE="/scratch/maitreje/dsw/phase_H_prime_M_I3_combined_cache"
mkdir -p "$OUT"

[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$BASE/data/inference/combined_steep_plain_v2.parquet" ] || \
    { echo "MISSING combined parquet"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" ] || \
    { echo "MISSING surrogate best.pt"; exit 1; }
[ -d "$CACHE" ] || { echo "MISSING cache dir (run materialise PBS first):$CACHE"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"
echo "=== M_I3 PROD scalar (M_H'1f) CFG=$CFG OUT=$OUT ==="
python -u services/module2b-surrogate/train_v2_devine_style.py \
  --config "$CFG" 2>&1 | tee "$OUT/train.log"
echo "=== scalar train exit=${PIPESTATUS[0]} ==="
tail -30 "$OUT/history.yaml" 2>/dev/null || echo "no history.yaml"
