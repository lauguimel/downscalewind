#!/bin/bash -l
#PBS -N devine_M_I8_v3_capacity
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1:gpu_id=H100
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -m n

# M_I8-CAPACITY — parallel arm testing "the correction network is under-sized
# for the enriched multi-height task". Same data/cache/surrogate v3 as the main
# M_I8 run, but ANNCorrection widened 92,576 -> 362,056 params (3.91x,
# hidden_units [320,160], terrain_latent_dim 128) and trained FROM SCRATCH
# (no init_from — a narrower checkpoint cannot shape-match this network, see
# devine_style_M_I8_capacity_v3.yaml header for the empirical proof).
# epochs = 5, NOT 20: train_v2_devine_style.py has no resume mechanism (no
# resume/start_epoch key; init_from only restores the ANN weights, never the
# optimizer/schedule; the epoch loop always starts at 0), so a run killed by
# walltime cannot be continued — it must finish inside this single 48h
# submission. At a conservative 8h/epoch (M_I7b's 4-epoch fine-tune took ~35h
# wall including cache materialisation), 5 epochs leaves headroom under 48h
# for the from-scratch run's own first-epoch cache-materialisation cost. 48h
# is already the highest walltime ever requested anywhere in configs/hpc/ (tied
# with a few other train_v2 jobs) — raising it further is untested against
# Aqua's scheduler, so epochs was lowered instead of walltime raised.
# LIMITATION: 5 epochs from scratch may not converge to a fair comparison
# against M_I7b's 4-epoch FINE-TUNE (which started from an already-trained
# model) — read the per-epoch val curve, not just best.pt, before concluding
# capacity helped or hurt.
# Post-train eval kwargs kept in sync with training (known M_H'1f trap).

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_I8_capacity_v3.yaml"
OUT="$BASE/data/models/surrogate_v3_devine_M_I8_capacity"
CACHE="/scratch/maitreje/dsw/phase_H_prime_M_I3_combined_cache"
mkdir -p "$OUT"

[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$BASE/data/inference/combined_steep_plain_v2.parquet" ] || \
    { echo "MISSING combined parquet"; exit 1; }
[ -f "$BASE/data/inference/multiheight_towers_v1.parquet" ] || \
    { echo "MISSING multiheight parquet"; exit 1; }
[ -f "$BASE/data/models/surrogate_v3_vit_base_agl200_k32/best.pt" ] || \
    { echo "MISSING v3 surrogate best.pt"; exit 1; }
[ -d "$BASE/data/raw/era5_hourly_jja2020_eu_wide.zarr" ] || \
    { echo "MISSING jja2020 EU-wide ERA5 store"; exit 1; }
[ -d "$CACHE" ] || { echo "MISSING production cache (M_I3):$CACHE"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"
echo "=== M_I8-CAPACITY (from scratch, 3.91x params) CFG=$CFG OUT=$OUT ==="
python -u services/module2b-surrogate/train_v2_devine_style.py \
  --config "$CFG" 2>&1 | tee "$OUT/train.log"
RC_TRAIN=${PIPESTATUS[0]}
if [ $RC_TRAIN -ne 0 ]; then
    echo "TRAIN FAILED rc=$RC_TRAIN"
    exit $RC_TRAIN
fi

if [ -f "$OUT/best.pt" ]; then
    echo "=== eval (raw vs corrected) on val set ==="
    python -u services/module2b-surrogate/eval_devine_style.py \
      --config "$CFG" \
      --ann-checkpoint "$OUT/best.pt" \
      --out-dir "$OUT" 2>&1 | tee "$OUT/eval.log"
else
    echo "WARNING: no best.pt produced; skipping eval"
fi
echo "=== summary ==="
cat "$OUT/eval_summary.json" 2>/dev/null || echo "no eval_summary.json"
tail -50 "$OUT/history.yaml" 2>/dev/null || echo "no history.yaml"
