#!/bin/bash -l
#PBS -N eval_loso_h100
#PBS -l select=1:ncpus=8:mem=32GB:ngpus=1:gpu_id=H100
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n

cd "$PBS_O_WORKDIR"

BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_full_M_H1.yaml"
ANN="$BASE/data/models/surrogate_v2_devine_M_H1_jja/best.pt"
OUT="$BASE/data/validation/phase_H_prime_loso"
OBS="$BASE/data/raw/obs_unified_noaa_isd_prod.zarr"
CACHE="/scratch/maitreje/dsw/phase_H_prime_M_H1_jja_cache"

mkdir -p "$OUT"
[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$ANN" ] || { echo "MISSING ANN:$ANN"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" ] || \
    { echo "MISSING surrogate best.pt"; exit 1; }
[ -f "$BASE/data/inference/noaa_jja2023_v2.parquet" ] || { echo "MISSING JJA parquet"; exit 1; }
[ -d "$OBS" ] || { echo "MISSING OBS:$OBS"; exit 1; }
[ -d "$CACHE" ] || { echo "BLOCKED: missing grid.zarr cache $CACHE; do not rematerialise"; exit 2; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

cd "$BASE"
echo "=== M_H'1d LOSO dry-run CPU ==="
python -u services/module2b-surrogate/eval_devine_loso.py \
  --config "$CFG" \
  --ann-checkpoint "$ANN" \
  --out-dir "$OUT" \
  --obs-store "$OBS" \
  --device cpu \
  --dry-run \
  --limit-batches 1 \
  --max-pairings 4 \
  --batch-size 2 \
  --num-workers 0 \
  --n-prep-workers 1 2>&1 | tee "$OUT/dryrun.log"
RC_DRY=${PIPESTATUS[0]}
echo "RC_DRY=$RC_DRY"
[ "$RC_DRY" -eq 0 ] || exit "$RC_DRY"

echo "=== M_H'1d LOSO full CUDA evaluation ==="
nvidia-smi -L
python -u services/module2b-surrogate/eval_devine_loso.py \
  --config "$CFG" \
  --ann-checkpoint "$ANN" \
  --out-dir "$OUT" \
  --obs-store "$OBS" \
  --device cuda 2>&1 | tee "$OUT/eval_devine_loso.log"
RC_EVAL=${PIPESTATUS[0]}
echo "RC_EVAL=$RC_EVAL"
[ "$RC_EVAL" -eq 0 ] || exit "$RC_EVAL"

python - <<'PY'
import json, pandas as pd
base="data/validation/phase_H_prime_loso"
df=pd.read_csv(f"{base}/per_station_loso.csv")
need={"station_id","lat","lon","split","n_pairings","mae_corrected","mae_raw",
      "mae_era5_baseline","bias_corrected","bias_raw","mae_dir_corrected",
      "mae_dir_raw","mae_dir_era5","bias_dir_corrected"}
assert need<=set(df.columns), f"missing cols: {need-set(df.columns)}"
assert 200<=len(df)<=230, f"unexpected row count {len(df)}"
assert set(df["split"].unique()) <= {"train","val"}, df["split"].unique()
pd.read_csv(f"{base}/speed_mae_by_sector.csv")
dd=pd.read_csv(f"{base}/direction_deflection.csv")
need_dd={"station_id","defl_corr_minus_era5_deg","z0_eff","std_topo"}
assert need_dd<=set(dd.columns), f"missing deflection cols: {need_dd-set(dd.columns)}"
s=json.load(open(f"{base}/loso_summary.json"))
assert {"coverage","speed","direction","deflection"}<=set(s), set(s)
assert s["coverage"]["kept"]>=1000, s["coverage"]
assert not s["coverage"].get("val_stations_with_zero_pairings"), s["coverage"]
v=s["speed"]["val"]
d=s["direction"].get("val", s["direction"])
f=s["deflection"]
print("val mae_corrected", v["mae_corrected"],
      "val mae_raw", v["mae_raw"],
      "val mae_era5_baseline", v["mae_era5_baseline"])
print("val mae_dir corrected/raw/era5",
      d["mae_dir_deg_corrected"], d["mae_dir_deg_raw"], d["mae_dir_deg_era5"],
      "n_stations_gt_30deg", d["n_stations_gt_30deg"])
print("deflection corr pearson z0/std",
      f.get("pearson_abs_defl_vs_z0_eff"), f.get("pearson_abs_defl_vs_std_topo"),
      "spearman z0/std",
      f.get("spearman_abs_defl_vs_z0_eff"), f.get("spearman_abs_defl_vs_std_topo"))
print("EXIT CRITERION PASS", len(df), "rows")
PY
