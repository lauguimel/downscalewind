#!/bin/bash -l
#PBS -N fuxi_vs_ours
#PBS -l select=1:ncpus=8:mem=48GB:ngpus=1:gpu_id=A100
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -m n

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"

CFG="$BASE/configs/training/devine_style_M_I5_encoder.yaml"
ANN="$BASE/data/models/surrogate_v2_devine_M_I5_encoder/best.pt"
COMBINED="$BASE/data/inference/combined_steep_plain_v2.parquet"
PERD_OBS="$BASE/data/raw/perdigao_obs.zarr"
STORES="$BASE/data/raw"
ONNX="$BASE/data/models/fuxicfd_official/fuxicfd-model/model/fuxicfd_model.onnx"
SCALER="$BASE/data/models/fuxicfd_official/fuxicfd-model/inference_example/normalization"
PERD_STORE="$BASE/data/raw/era5_europe_spring2017_v2.zarr"
PERD_CACHE="/scratch/maitreje/dsw/fuxi_vs_ours_perdigao_cache"
OUT="$BASE/data/validation/fuxi_vs_ours"

NPS="${NPS:-12}"        # timestamps/station (val)
PNPS="${PNPS:-10}"      # timestamps/station (Perdigao)

mkdir -p "$OUT" "$PERD_CACHE"
for f in "$CFG" "$ANN" "$COMBINED" "$ONNX" "$PERD_STORE"; do
  [ -e "$f" ] || { echo "MISSING:$f"; exit 1; }
done
[ -d "$PERD_OBS" ] || { echo "MISSING:$PERD_OBS"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
  [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8

cd "$BASE"
nvidia-smi -L

echo "=== FuXi-CFD vs OUR M_I5 vs ERA5 — head-to-head scoring (NPS=$NPS PNPS=$PNPS) ==="
python -u services/module2b-surrogate/score_fuxi_vs_ours.py \
  --config "$CFG" --ann-checkpoint "$ANN" \
  --combined-parquet "$COMBINED" --perdigao-obs "$PERD_OBS" \
  --stores-root "$STORES" \
  --onnx "$ONNX" --scaler-dir "$SCALER" \
  --perdigao-era5-store "$PERD_STORE" --perdigao-cache-dir "$PERD_CACHE" \
  --out-dir "$OUT" \
  --n-per-station "$NPS" --perdigao-n-per-station "$PNPS" \
  --device cuda --fuxi-device cuda \
  --batch-size 16 --fuxi-batch-size 16 \
  --max-delta-h 1.5 --n-prep-workers 8 --seed 42 \
  2>&1 | tee "$OUT/score.log"
RC=${PIPESTATUS[0]}
echo "RC_SCORE=$RC"
exit "$RC"
