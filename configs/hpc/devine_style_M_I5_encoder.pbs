#!/bin/bash -l
#PBS -N devine_M_I5_encoder
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1:gpu_id=H100
#PBS -l walltime=36:00:00
#PBS -j oe
#PBS -m n

# M_I5b PRODUCTION — ENCODER arm (M_H'1g) with the REGIME-AWARE loss fix for the
# low-wind over-correction. Arch UNCHANGED vs M_I3; only the loss differs
# (loss_mode=regime: stronger over-prediction penalty in calm, high-wind branch
# untouched). Combined steep+plain dataset (609,388 pairings, 529 stations).
# Reuses the pre-materialised PRODUCTION cache (shared with M_I3, NO re-materialise).
# 6 epochs (~5.5 h each on 489k → 33 h; 36 h walltime to be safe). best.pt/epoch.
# NEW output dir — does NOT overwrite the M_I3 models.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_I5_encoder.yaml"
OUT="$BASE/data/models/surrogate_v2_devine_M_I5_encoder"
CACHE="/scratch/maitreje/dsw/phase_H_prime_M_I3_combined_cache"
mkdir -p "$OUT"

[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$BASE/data/inference/combined_steep_plain_v2.parquet" ] || \
    { echo "MISSING combined parquet"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" ] || \
    { echo "MISSING surrogate best.pt"; exit 1; }
[ -d "$CACHE" ] || { echo "MISSING production cache (M_I3):$CACHE"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"
echo "=== M_I5 PROD encoder (regime loss) CFG=$CFG OUT=$OUT ==="
python -u services/module2b-surrogate/train_v2_devine_style.py \
  --config "$CFG" 2>&1 | tee "$OUT/train.log"
echo "=== encoder train exit=${PIPESTATUS[0]} ==="
tail -40 "$OUT/history.yaml" 2>/dev/null || echo "no history.yaml"
