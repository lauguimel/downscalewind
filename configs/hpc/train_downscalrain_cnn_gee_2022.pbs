#!/bin/bash -l
#PBS -N downrain_gee22
#PBS -l select=1:ncpus=8:mem=96GB:ngpus=1:gpu_id=H100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m n

set -euo pipefail

cd "$PBS_O_WORKDIR"

DATASET="${DATASET:-/scratch/maitreje/dsw/downscalrain/patches_gee_2022}"
OUT="${OUT:-$HOME/dsw/data/models/downscalrain_cnn_gee_2022}"
VAL="${VAL:-$HOME/dsw/data/validation/downscalrain_cnn_gee_2022}"
CONFIG="${CONFIG:-$HOME/dsw/services/module3-precip/configs/downscalrain_cnn_gee_2022.yaml}"
EPOCHS="${EPOCHS:-20}"
BATCH_SIZE="${BATCH_SIZE:-1024}"
PRED_BATCH_SIZE="${PRED_BATCH_SIZE:-2048}"

mkdir -p "$OUT" "$VAL"
[ -d "$DATASET" ] || { echo "MISSING DATASET: $DATASET"; exit 1; }
[ -f "$CONFIG" ] || { echo "MISSING CONFIG: $CONFIG"; exit 1; }
nvidia-smi || { echo "GPU missing"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate deforest

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export PYTHONUNBUFFERED=1

cd "$HOME/dsw/services/module3-precip"

python -u train_downscalrain.py \
  --config "$CONFIG" \
  --dataset "$DATASET" \
  --output "$OUT" \
  --device cuda \
  --batch-size "$BATCH_SIZE" \
  --epochs "$EPOCHS"

python -u predict_downscalrain.py \
  --checkpoint "$OUT/best.pt" \
  --dataset "$DATASET" \
  --output "$VAL/predictions.parquet" \
  --stats "$OUT/norm_stats.json" \
  --batch-size "$PRED_BATCH_SIZE" \
  --device cuda

python -u evaluate_downscalrain_cnn.py \
  --dataset "$DATASET" \
  --predictions "$VAL/predictions.parquet" \
  --split-manifest "$OUT/split_manifest.json" \
  --output-dir "$VAL"

python -u calibrate_downscalrain_fire_threshold.py \
  --predictions "$VAL/downscalrain_cnn_predictions_enriched.parquet" \
  --output "$VAL/downscalrain_cnn_predictions_enriched_firecal.parquet" \
  --calibration-json "$VAL/downscalrain_firecalibration.json" \
  --threshold-table "$VAL/fire_threshold_sweep.csv"

python -u evaluate_downscalrain_fire_periods.py \
  --predictions "$VAL/downscalrain_cnn_predictions_enriched_firecal.parquet" \
  --station-table "$HOME/dsw/data/raw/precip_correction_cache/dataset_2022.parquet" \
  --output-dir "$VAL"
