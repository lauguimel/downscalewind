#!/bin/bash -l
#PBS -N devine_M_I3_smoke
#PBS -l select=1:ncpus=16:mem=64GB:ngpus=1
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -m n

# M_I3 SMOKE — run BOTH architectures (scalar M_H'1f, encoder M_H'1g) on a tiny
# JJA steep subset to confirm: loss decreases, no shape/cache crash, frozen
# surrogate loads, topo_dim=12 path. On-the-fly materialisation into a throwaway
# cache. NOT a production run.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"

for ARM in scalar encoder; do
  CFG="$BASE/configs/training/devine_style_M_I3_${ARM}_smoke.yaml"
  OUT="$BASE/data/models/surrogate_v2_devine_M_I3_${ARM}_smoke"
  mkdir -p "$OUT"
  echo "============================================================"
  echo "=== M_I3 SMOKE arm=$ARM CFG=$CFG ==="
  echo "============================================================"
  python -u services/module2b-surrogate/train_v2_devine_style.py \
    --config "$CFG" 2>&1 | tee "$OUT/smoke.log"
  RC=${PIPESTATUS[0]}
  echo "=== arm=$ARM exit_code=$RC ==="
  if [ $RC -ne 0 ]; then
    echo "SMOKE FAILED arm=$ARM rc=$RC"
  fi
done
echo "=== M_I3 SMOKE done (both arms) ==="
