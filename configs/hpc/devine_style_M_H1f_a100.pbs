#!/bin/bash -l
#PBS -N devine_H1f_a100
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1:gpu_id=A100
#PBS -l walltime=14:00:00
#PBS -j oe
#PBS -m n

# Phase H' M_H'1a — JJA 2023 only (priorité fire weather / NatComms paper)
# Config V2 (winner Dept A sweep) : lr=5e-4 + grad_clip=1.0, tau DEVINE default
# Dataset = JJA 2023 FR/ES/PT = 63k pairings, 214 unique stations
# ETA ~30-40h on H100 ; ~3.8h materialisation + ~5h/epoch × 6-8 epochs

cd "$PBS_O_WORKDIR"

BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_H1f.yaml"
OUT="$BASE/data/models/surrogate_v2_devine_M_H1f_physfeat"
mkdir -p "$OUT"

[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" ] || \
    { echo "MISSING surrogate best.pt"; exit 1; }
[ -f "$BASE/data/inference/noaa_jja2023_v2.parquet" ] || \
    { echo "MISSING JJA parquet"; exit 1; }
[ -d "$BASE/data/raw/worldcover_esa" ] || \
    { echo "MISSING worldcover dir"; exit 1; }
[ -d "$BASE/data/raw/srtm_tiles" ] || \
    { echo "MISSING srtm tiles dir"; exit 1; }
nvidia-smi -L

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

cd "$BASE"
echo "=== Phase H' M_H'1 FULL devine_style ==="
echo "CFG=$CFG"
echo "OUT=$OUT"

python -u services/module2b-surrogate/train_v2_devine_style.py \
  --config "$CFG" 2>&1 | tee "$OUT/train.log"
RC_TRAIN=${PIPESTATUS[0]}
if [ $RC_TRAIN -ne 0 ]; then
    echo "TRAIN FAILED rc=$RC_TRAIN"
    exit $RC_TRAIN
fi

if [ -f "$OUT/best.pt" ]; then
    echo "=== eval (raw vs corrected) on val set ==="
    python -u services/module2b-surrogate/eval_devine_style.py \
      --config "$CFG" \
      --ann-checkpoint "$OUT/best.pt" \
      --out-dir "$OUT" 2>&1 | tee "$OUT/eval.log"
else
    echo "WARNING: no best.pt produced; skipping eval"
fi

echo "=== summary ==="
cat "$OUT/eval_summary.json" 2>/dev/null || echo "no eval_summary.json"
echo "=== history tail ==="
tail -50 "$OUT/history.yaml" 2>/dev/null || echo "no history.yaml"
