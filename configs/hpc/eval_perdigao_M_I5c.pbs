#!/bin/bash -l
#PBS -N eval_perd_M_I5c
#PBS -l select=1:ncpus=8:mem=32GB:ngpus=1:gpu_id=A100
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m n

cd "$PBS_O_WORKDIR"

BASE="$HOME/dsw"
# M_I5c — Perdigão IOP eval of the REGIME-AWARE encoder correction (M_I5 best.pt).
# Arch is the M_I3 encoder (use_terrain_encoder); only the trained weights differ.
SURR="$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt"
OBS_ZARR="$BASE/data/raw/perdigao_obs.zarr"
CACHE="/scratch/maitreje/dsw/phase_H_prime_perdigao_cache"

CFG_ENC="$BASE/configs/training/eval_perdigao_M_I3_encoder.yaml"
ANN_ENC="$BASE/data/models/surrogate_v2_devine_M_I5_encoder/best.pt"
OUT_ENC="$BASE/data/validation/phase_H_prime_perdigao_M_I5_encoder"

mkdir -p "$OUT_ENC" "$CACHE"
[ -f "$SURR" ] || { echo "MISSING surrogate best.pt"; exit 1; }
[ -d "$OBS_ZARR" ] || { echo "MISSING OBS_ZARR:$OBS_ZARR"; exit 1; }
[ -f "$CFG_ENC" ] || { echo "MISSING CFG_ENC:$CFG_ENC"; exit 1; }
[ -f "$ANN_ENC" ] || { echo "MISSING ANN_ENC:$ANN_ENC"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

cd "$BASE"
nvidia-smi -L

echo "=== M_I5c ENCODER (regime) full CUDA evaluation ==="
python -u services/validation/audit_devine_perdigao.py \
  --config "$CFG_ENC" --ann-checkpoint "$ANN_ENC" --obs-zarr "$OBS_ZARR" \
  --cache-dir "$CACHE" --out-dir "$OUT_ENC" \
  --time-subsample 8 --device cuda 2>&1 | tee "$OUT_ENC/eval_perdigao.log"
RC=${PIPESTATUS[0]}
echo "RC_EVAL=$RC"

echo "=== M_I5c PERDIGAO SUMMARY ==="
python - <<'PY'
import json, os
p = "data/validation/phase_H_prime_perdigao_M_I5_encoder/perdigao_summary.json"
if not os.path.exists(p):
    print("NO SUMMARY (eval failed)")
else:
    s = json.load(open(p)); cm = s["centre_mae"]; pr = s["propagation"]
    print(f"ENCODER(regime): centre_mae corr={cm['corrected']:.4f} raw={cm['raw']:.4f} "
          f"bias_corr={cm['bias_corrected']:+.4f} bias_raw={cm['bias_raw']:+.4f} "
          f"n_pair={cm['n_pairings']} n_sta={cm['n_stations']} | "
          f"pct_smooth={pr['pct_smooth']:.1f} pct_spike={pr['pct_spike']:.1f}")
PY

exit "$RC"
