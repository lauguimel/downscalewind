#!/bin/bash -l
#PBS -N hub_penmanshiel
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -m n

# Hub-height out-of-sample benchmark — Penmanshiel 2018, 14 turbines x 8760 h.
# RAW surrogate v3 vs M_I8-calibrated, inputs materialised on the fly into /scratch
# (~120 KB per entry, ~15 GB total). Smoke (200 rows) first, then full run, then scoring.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
TRAIN_CFG="$BASE/configs/training/devine_style_M_I8_multiheight_v3.yaml"
SITE_CFG="$BASE/configs/validation/hub_height_penmanshiel_aqua.yaml"
ERA5="$BASE/data/raw/era5_penmanshiel_2018.zarr"
OUT="$BASE/data/validation/hub_height_benchmark/penmanshiel_2018"
mkdir -p "$OUT"
for f in "$TRAIN_CFG" "$SITE_CFG" "$BASE/data/inference/penmanshiel_turbines_v1.parquet" \
         "$BASE/data/raw/worldcover_per_site/penmanshiel.tif" \
         "$BASE/data/raw/srtm_tiles/Copernicus_DSM_COG_10_N55_00_W003_00_DEM.tif"; do
  [ -e "$f" ] || { echo "MISSING:$f"; exit 1; }
done
[ -d "$ERA5/coords" ] || { echo "MISSING ERA5 store:$ERA5"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
nvidia-smi -L
cd "$BASE"

echo "=== SMOKE (200 rows) ==="
python -u services/validation/run_hub_height_inference.py \
  --train-config "$TRAIN_CFG" --site-config "$SITE_CFG" --device cuda \
  --batch-size 8 --num-workers 2 --n-prep-workers 8 --max-rows 200 2>&1 | tee "$OUT/smoke.log"
RC=${PIPESTATUS[0]}; echo "RC_SMOKE=$RC"; [ "$RC" -eq 0 ] || exit "$RC"
mv "$OUT/predictions.parquet" "$OUT/predictions_smoke.parquet"
mv "$OUT/summary.json" "$OUT/summary_smoke.json"

echo "=== FULL (14 turbines x 8760 h) ==="
python -u services/validation/run_hub_height_inference.py \
  --train-config "$TRAIN_CFG" --site-config "$SITE_CFG" --device cuda \
  --batch-size 32 --num-workers 4 --n-prep-workers 14 2>&1 | tee "$OUT/full.log"
RC=${PIPESTATUS[0]}; echo "RC_FULL=$RC"; [ "$RC" -eq 0 ] || exit "$RC"

echo "=== SCORE ==="
U100="$BASE/data/raw/era5_penmanshiel_2018_u100.zarr"
EXTRA=""; [ -d "$U100/coords" ] && EXTRA="--era5-u100 $U100"
python -u services/validation/score_hub_height.py \
  --pairings data/inference/penmanshiel_turbines_v1.parquet \
  --predictions "$OUT/predictions.parquet" \
  --newa data/raw/newa_ts/newa_penmanshiel_2018.parquet \
  --gwa-json data/raw/gwa_points_hub_sites.json --gwa-site penmanshiel \
  --hub-height 59 --rated-kw 2050 --out-dir "$OUT" $EXTRA 2>&1 | tee "$OUT/score.log"
cat "$OUT/summary.json"
