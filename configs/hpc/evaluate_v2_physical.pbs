#!/bin/bash -l
#PBS -N eval_v2_phys
#PBS -l select=1:ncpus=8:mem=32GB:ngpus=1:gpu_id=A100
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n

cd $PBS_O_WORKDIR

: "${MODEL_TYPE:?MODEL_TYPE is required: fno or vit}"
: "${WEIGHTS:?WEIGHTS is required}"
: "${OUT:?OUT is required}"
: "${SPLIT:=test}"
: "${PRESET:=base}"

CAMPAIGN="/scratch/maitreje/dsw/complex_terrain_v1"
DATA="/scratch/maitreje/dsw/training_v2"

[ -d "$DATA" ] || { echo MISSING:$DATA; exit 1; }
[ -f "$WEIGHTS" ] || { echo MISSING:$WEIGHTS; exit 1; }
[ -f "$CAMPAIGN/manifests/dataset_v2_norm.yaml" ] || { echo MISSING:dataset_v2_norm.yaml; exit 1; }
nvidia-smi >/dev/null || { echo "GPU missing"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

cd $HOME/dsw/services/module2b-surrogate
python -u evaluate_v2_physical.py \
  --model-type "$MODEL_TYPE" \
  --weights "$WEIGHTS" \
  --data-dir "$DATA" \
  --splits-yaml "$CAMPAIGN/manifests/dataset_v2_splits.yaml" \
  --norm-yaml "$CAMPAIGN/manifests/dataset_v2_norm.yaml" \
  --split "$SPLIT" \
  --output "$OUT" \
  --device cuda \
  --amp \
  --per-case \
  --log-every 25 \
  --vit-preset "$PRESET"
