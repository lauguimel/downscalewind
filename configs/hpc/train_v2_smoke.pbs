#!/bin/bash -l
#PBS -N train_v2_smoke
#PBS -l select=1:ncpus=4:mem=32GB:ngpus=1:gpu_id=H100
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -m n

# Smoke test: 1 epoch, 8 train cases, 4 val cases, batch_size 2.
# Validates env, dataset loading, model forward+backward, GPU usage.

cd $PBS_O_WORKDIR

CAMPAIGN="/scratch/maitreje/dsw/complex_terrain_v1"
DATA="/scratch/maitreje/dsw/training_v2"
OUT="$HOME/dsw/data/models/surrogate_v2_smoke"
LOG="$HOME/dsw/data/campaign/complex_terrain_v1/manifests/train_v2_smoke.log"

mkdir -p "$OUT" "$(dirname $LOG)"

# Pre-flight
[ -d $DATA ] || { echo MISSING:$DATA; exit 1; }
[ -f $CAMPAIGN/manifests/dataset_v2_norm.yaml ] || { echo MISSING:dataset_v2_norm.yaml; exit 1; }
nvidia-smi || { echo "GPU missing"; exit 1; }

# Conda
module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
python -c 'import torch; print("torch", torch.__version__, "cuda", torch.cuda.is_available()); import zarr; print("zarr", zarr.__version__)' 2>&1 | tee -a $LOG

cd $HOME/dsw/services/module2b-surrogate
python -u train_v2.py \
  --data-dir   $DATA \
  --splits-yaml $CAMPAIGN/manifests/dataset_v2_splits.yaml \
  --norm-yaml   $CAMPAIGN/manifests/dataset_v2_norm.yaml \
  --out-dir    $OUT \
  --epochs 1 \
  --batch-size 2 \
  --width 16 \
  --modes 8 8 4 \
  --n-layers 2 \
  --num-workers 0 \
  --max-train-cases 8 \
  --max-val-cases 4 \
  --device cuda \
  2>&1 | tee -a $LOG
