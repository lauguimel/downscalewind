#!/bin/bash -l
#PBS -N eval_abl_A
#PBS -l select=1:ncpus=24:mem=96GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m n

# Per-row predictions of ablation A (ANNDirect, no surrogate) on the same 140k val
# pairings as M_I8 -> eval_pairings.parquet, input of skill_map.py and of the paired
# comparison with M_I8 (compare_paired.py). CPU: the model is 88 k params.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/ablation_ann_only_A_terrain_cnn.yaml"
ANN="$BASE/data/models/ablation_ann_only_A_terrain_cnn/best.pt"
OUT="$BASE/data/validation/skill_map_ablation_A"
mkdir -p "$OUT"
[ -f "$ANN" ] || { echo "MISSING ANN:$ANN"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8
ulimit -n 65536 2>/dev/null || ulimit -n 8192 2>/dev/null || true

cd "$BASE"
python -u services/module2b-surrogate/eval_devine_style.py \
  --config "$CFG" --ann-checkpoint "$ANN" --out-dir "$OUT" 2>&1 | tee "$OUT/eval.log"
echo "RC_EVAL=${PIPESTATUS[0]}"
cat "$OUT/eval_summary.json" 2>/dev/null
