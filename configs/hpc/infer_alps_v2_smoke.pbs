#!/bin/bash -l
#PBS -N infer_alps_smoke
#PBS -l select=1:ncpus=8:mem=48GB:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -m n

# M_I2a SMOKE — validate surrogate-v2 inference at NEW Alpine ridge stations.
# 3 high-altitude Alps stations (lon <= 10E so inside the JJA hourly ERA5 grid)
# × ~28 JJA-2023 timestamps. Checks DEM/WC auto-resolve at Alps coords + physical
# speed_pred paired to speed_obs.

cd $PBS_O_WORKDIR
BASE="$HOME/dsw"

module load Miniconda3/24.9.2-0
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2

cd "$BASE"

python -u services/module2b-surrogate/infer_at_stations.py \
  --obs-zarrs "$BASE/data/raw/obs_unified_alps_smoke.zarr" \
  --era5-store "$BASE/data/raw/era5_europe_hourly_jja2023.zarr" \
  --checkpoint "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" \
  --norm-yaml /scratch/maitreje/dsw/complex_terrain_v1/manifests/dataset_v2_norm.yaml \
  --dem "$BASE/data/raw/srtm_tiles/" \
  --worldcover "$BASE/data/raw/worldcover_esa/" \
  --output "$BASE/data/inference/smoke_alps_jja_v2.parquet" \
  --device cuda --amp \
  --batch-size 8 \
  --workdir "/scratch/maitreje/dsw/infer_alps_smoke_workdir" \
  --n-prep-workers 4 \
  --smoke --keep-grids
