#!/bin/bash -l
#PBS -N eval_M_I8_val
#PBS -l select=1:ncpus=16:mem=96GB:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -m n

# Per-row raw / corrected / ERA5 10 m predictions of M_I8 on its 140k val pairings
# (never-seen stations). The eval chained after training on 2026-09-06 was killed by
# the 40 h walltime, so eval_pairings.parquet was never written. Input of the skill
# map (gain vs ERA5 as a function of terrain relief, wind class, height).
# Cache is fully materialised -> read-only, no CDS / DEM work expected.

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_I8_multiheight_v3.yaml"
ANN="$BASE/data/models/surrogate_v3_devine_M_I8_multiheight/best.pt"
OUT="$BASE/data/validation/skill_map_M_I8"
mkdir -p "$OUT"
[ -f "$ANN" ] || { echo "MISSING ANN:$ANN"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"
python -u services/module2b-surrogate/eval_devine_style.py \
  --config "$CFG" --ann-checkpoint "$ANN" --out-dir "$OUT" 2>&1 | tee "$OUT/eval.log"
echo "RC_EVAL=${PIPESTATUS[0]}"
cat "$OUT/eval_summary.json" 2>/dev/null
