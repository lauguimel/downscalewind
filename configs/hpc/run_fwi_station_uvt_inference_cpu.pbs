#!/bin/bash -l
#PBS -N fwi_uvt_station_cpu
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -m n

cd $PBS_O_WORKDIR

BASE="$HOME/dsw"
: "${RUN_DIR:=$BASE/data/validation/fwi_station_audit_2022_n20}"
: "${MANIFEST:=$RUN_DIR/station_v2_grid_inputs_copdem/station_v2_grid_manifest.csv}"
: "${WEIGHTS:=$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24/best.pt}"
: "${NORM:=/scratch/maitreje/dsw/complex_terrain_v1/manifests/dataset_v2_norm.yaml}"
: "${OUT:=$RUN_DIR/downscalewind_uvt_station_agl100_copdem.csv}"

[ -f "$MANIFEST" ] || { echo MISSING:$MANIFEST; exit 1; }
[ -f "$WEIGHTS" ] || { echo MISSING:$WEIGHTS; exit 1; }
[ -f "$NORM" ] || { echo MISSING:$NORM; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-8}"

cd "$BASE"
python -u services/validation/run_station_surrogate_inference.py \
  --manifest "$MANIFEST" \
  --weights "$WEIGHTS" \
  --norm-yaml "$NORM" \
  --output "$OUT" \
  --device cpu \
  --strict
