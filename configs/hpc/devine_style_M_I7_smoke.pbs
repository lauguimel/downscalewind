#!/bin/bash -l
#PBS -N devine_M_I7_smoke
#PBS -l select=1:ncpus=16:mem=64GB:ngpus=1:gpu_id=H100
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m n

# M_I7 SMOKE — multi-height fine-tune (~500 pairings, 2 epochs) + post-train
# eval. Validates: merged parquet + WeightedRandomSampler, calm gate + init_from
# M_I5 best.pt, multiheight materialisation (jja2020 EU-wide + iop2017 stores),
# >100 m filter, per-sample k_obs at 20-100 m. Eval kwargs kept in sync with
# training (known M_H'1f trap).

cd "$PBS_O_WORKDIR"
BASE="$HOME/dsw"
CFG="$BASE/configs/training/devine_style_M_I7_multiheight_smoke.yaml"
OUT="$BASE/data/models/surrogate_v2_devine_M_I7_multiheight_smoke"
CACHE="/scratch/maitreje/dsw/phase_H_prime_M_I3_combined_cache"
mkdir -p "$OUT"

[ -f "$CFG" ] || { echo "MISSING CFG:$CFG"; exit 1; }
[ -f "$BASE/data/inference/combined_steep_plain_v2.parquet" ] || \
    { echo "MISSING combined parquet"; exit 1; }
[ -f "$BASE/data/inference/multiheight_towers_v1.parquet" ] || \
    { echo "MISSING multiheight parquet"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_vit_base_resid_s4_geo_agl100_k24_surface/best.pt" ] || \
    { echo "MISSING surrogate best.pt"; exit 1; }
[ -f "$BASE/data/models/surrogate_v2_devine_M_I5_encoder/best.pt" ] || \
    { echo "MISSING M_I5 best.pt (init_from)"; exit 1; }
[ -d "$BASE/data/raw/era5_hourly_jja2020_eu_wide.zarr" ] || \
    { echo "MISSING jja2020 EU-wide ERA5 store"; exit 1; }
[ -d "$CACHE" ] || { echo "MISSING production cache (M_I3):$CACHE"; exit 1; }

module load Miniconda3/24.9.2-0 || module load Anaconda3/2024.02-1
eval "$(conda shell.bash hook)"
conda activate fuxicfd
for d in $CONDA_PREFIX/lib/python*/site-packages/nvidia/*/lib; do
    [ -d "$d" ] && export LD_LIBRARY_PATH="$d:$LD_LIBRARY_PATH"
done
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2

nvidia-smi -L
cd "$BASE"
echo "=== M_I7 SMOKE multiheight CFG=$CFG OUT=$OUT ==="
python -u services/module2b-surrogate/train_v2_devine_style.py \
  --config "$CFG" 2>&1 | tee "$OUT/smoke.log"
RC_TRAIN=${PIPESTATUS[0]}
if [ $RC_TRAIN -ne 0 ]; then
    echo "SMOKE TRAIN FAILED rc=$RC_TRAIN"
    exit $RC_TRAIN
fi

if [ -f "$OUT/best.pt" ]; then
    echo "=== eval (raw vs corrected) on val set ==="
    python -u services/module2b-surrogate/eval_devine_style.py \
      --config "$CFG" \
      --ann-checkpoint "$OUT/best.pt" \
      --out-dir "$OUT" 2>&1 | tee "$OUT/eval.log"
else
    echo "WARNING: no best.pt produced; skipping eval"
fi
echo "=== summary ==="
cat "$OUT/eval_summary.json" 2>/dev/null || echo "no eval_summary.json"
tail -30 "$OUT/history.yaml" 2>/dev/null || echo "no history.yaml"
